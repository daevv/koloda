# Required on Vercel. openssl rand -base64 32
# Locally, if empty, the app creates data/session-secret on first launch.
SESSION_SECRET=

# Supabase → Project Settings → API
# Use the service_role key only on the server. Never put it in client code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# https://developers.pinterest.com/apps/
# Enable scopes: boards:read, boards:read_secret, pins:read, pins:read_secret, user_accounts:read
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# Must match the redirect URI in the Pinterest app exactly.
PINTEREST_REDIRECT_URI=http://localhost:3000/api/pinterest/callback
